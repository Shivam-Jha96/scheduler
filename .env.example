# ==============================================================================
# SchedulerBot Model C v4.4 HYBRID — Phase 1 MVP Environment Configuration
# Pure PostgreSQL 16+ (pg_cron >= 1.5, pgcrypto, uuid-ossp) — Zero Redis/BullMQ
# ==============================================================================

# Runtime
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL 16+ with pg_cron >= 1.5)
DATABASE_URL=postgresql://scheduler:scheduler_secret@localhost:5432/scheduler_db

# Cloud KMS Envelope Encryption & High-Entropy Blind Indexing (EPIC-13)
KMS_KEY_ID=alias/schedulerbot-dek
# For local dev / CI against isolated MockAPI_Server:
KMS_ENDPOINT_URL=http://localhost:8080
PHONE_PEPPER=replace-with-64-hex-kms-managed-pepper-secret-0123456789abcdef01
# Versioned App_DEK ciphertext (bootstrapped via scripts/bootstrap-app-dek.ts)
APP_DEK_CIPHERTEXT=
APP_DEK_MAP=

# Meta WhatsApp Business Cloud API v22.0 (EPIC-07)
META_GRAPH_API_BASE_URL=http://localhost:8080
META_GRAPH_API_VERSION=v22.0
META_APP_SECRET=dev-meta-app-secret
META_VERIFY_TOKEN=mock_verify_token_12345
WABA_PHONE_NUMBER_ID=15551234567
META_SYSTEM_USER_TOKEN=dev-system-user-token

# Volatile-RAM NLU Schedule Parsing Engine (EPIC-02)
NLU_ENDPOINT_URL=http://localhost:8080/v1/parse-schedule

# Optional local/CI MockAPI_Server base URL (M0-T3)
MOCK_API_BASE_URL=http://localhost:8080
