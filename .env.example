# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://scheduler:scheduler_secret@localhost:5432/scheduler_db?schema=public

# Redis (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Encryption (Zero-Knowledge AES-256-GCM Envelope)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
KEY_FINGERPRINT=v1-primary

# Ingress API Gateway
PORT=3000
HOST=0.0.0.0
API_KEY=dev-secret-api-key

# WhatsApp Cloud API (Meta WABA)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
