      "freeform_note": "Dispatched from +919876543210 to +919123456789"
    }
  },
  "anti_abuse_quotas": {
    "rolling_24h_active_limit": 5,
    "monthly_quota_period_limit": 20,
    "max_message_chars": 500
  }
}
