  "nlu_parse_schedule": {
    "canonical_intents": ["SCHEDULE_RELAY", "CANCEL_SCHEDULE", "OPT_OUT", "UNKNOWN"],
    "standard_schedule": {
      "request": {
        "raw_text": "Remind Bob (+919123456789) tomorrow at 9:00 AM to bring the project slides",
        "timezone": "Asia/Kolkata"
      },
      "expected_response": {
        "intent": "SCHEDULE_RELAY",
        "confidence": 0.96,
        "recipient_name": "Bob",
        "recipient_e164": "+919123456789",
        "scheduled_at_iso": "2026-11-26T09:00:00+05:30",
        "message_body": "Bring the project slides",
        "validation": {
          "is_valid": true,
          "missing_fields": [],
          "errors": []
        }
      }
    },
    "missing_phone_triggers_contact_card": {
      "request": {
        "raw_text": "Remind John tomorrow at 10am to call the client",
        "timezone": "Asia/Kolkata"
      },
      "expected_response": {
        "intent": "SCHEDULE_RELAY",
        "confidence": 0.91,
        "recipient_name": "John",
        "recipient_e164": null,
        "message_body": "Call the client",
        "validation": {
          "is_valid": false,
          "missing_fields": ["recipient_e164"],
          "errors": ["MISSING_RECIPIENT_PHONE"]
        }
      }
    },
    "cancel_hinglish": {
      "request": {
        "raw_text": "Kal subah 9 baje Raj wala message cancel kar do",
        "timezone": "Asia/Kolkata"
      },
      "expected_response": {
        "intent": "CANCEL_SCHEDULE",
        "confidence": 0.94,
        "recipient_name": "Raj",
        "validation": {
          "is_valid": true,
          "missing_fields": [],
          "errors": []
        }
      }
    },
    "oversized_body_rejected": {
      "request": {
        "raw_text": "Remind Bob (+919123456789) tomorrow at 9 AM: [501-char payload]",
        "timezone": "Asia/Kolkata"
      },
      "expected_response": {
        "intent": "SCHEDULE_RELAY",
        "validation": {
          "is_valid": false,
          "missing_fields": [],
          "errors": ["MESSAGE_EXCEEDS_500_CHARS"]
        }
      }
    }
  },
