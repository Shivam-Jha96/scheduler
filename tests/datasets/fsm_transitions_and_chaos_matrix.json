    { "from": "SENT_VIA_BOT", "to": "SENT_VIA_PERSONAL", "reason": "Terminal state immutable" },
    { "from": "SENT_VIA_BOT", "to": "CANCELLED", "reason": "Cannot cancel already delivered message" },
