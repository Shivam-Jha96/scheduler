    { "from": "EXPIRED", "to": "DISPATCHING", "reason": "Expired job must never fall back to bot" },
    { "from": "FAILED", "to": "DISPATCHING", "reason": "Failed is terminal after max_retries" },
    { "from": "PENDING", "to": "SENT_VIA_BOT", "reason": "Must pass through AWAITING_CONFIRMATION and DISPATCHING CAS lease" }
