    { "id": "TR-06", "from": "AWAITING_CONFIRMATION", "to": "DISPATCHING", "trigger": "T_PLUS_10M_OR_USER_DELEGATED", "guard": "auto_fallback = TRUE AND consent_status = OPTED_IN AND NOT globally opted out AND personal_send_confirmed_at IS NULL" },
    { "id": "TR-07", "from": "AWAITING_CONFIRMATION", "to": "EXPIRED", "trigger": "T_PLUS_10M_UNCONFIRMED_NO_FALLBACK", "guard": "auto_fallback = FALSE" },
    { "id": "TR-08", "from": "DISPATCHING", "to": "SENT_VIA_BOT", "trigger": "META_V22_HTTP_200", "guard": "valid unexpired worker lease" },
    { "id": "TR-09", "from": "DISPATCHING", "to": "AWAITING_CONFIRMATION", "trigger": "LEASE_REAPED_OR_HTTP_429", "guard": "retry_count + 1 < max_retries" },
    { "id": "TR-10", "from": "DISPATCHING", "to": "FAILED", "trigger": "RETRIES_EXHAUSTED_OR_NON_RETRYABLE_4XX", "guard": "retry_count + 1 >= max_retries" },
    { "id": "TR-11", "from": "PENDING", "to": "CANCELLED", "trigger": "ALICE_CANCEL_OR_BOB_OPT_OUT", "guard": "active non-terminal state" },
    { "id": "TR-12", "from": "NOTIFIED", "to": "CANCELLED", "trigger": "ALICE_CANCEL_OR_BOB_OPT_OUT", "guard": "active non-terminal state" },
    { "id": "TR-13", "from": "FAST_TRACK", "to": "CANCELLED", "trigger": "ALICE_CANCEL_OR_BOB_OPT_OUT", "guard": "active non-terminal state" },
    { "id": "TR-14", "from": "AWAITING_CONFIRMATION", "to": "CANCELLED", "trigger": "ALICE_CANCEL_OR_BOB_OPT_OUT", "guard": "active non-terminal state" }
  ],
  "illegal_transitions": [
