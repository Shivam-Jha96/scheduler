# ==============================================================================
# Cloudflare Tunnel Configuration Template
# Lean VPS Zero-Trust Ingress Profile (EP14-T1a / FR-NET-01 / BO-08)
# ==============================================================================
# Outbound-only Cloudflare QUIC tunnel ensuring 0 open public inbound WAN ports.
# Replace placeholders (${TUNNEL_ID}, ${TUNNEL_HOSTNAME}) during setup.
# ==============================================================================

tunnel: ${TUNNEL_ID}
credentials-file: /etc/cloudflared/${TUNNEL_ID}.json

# Transport Protocol: QUIC (HTTP/3 over UDP) for ultra-low latency & zero-RTT resumption
protocol: quic

# Internal telemetry: Bound strictly to localhost; never exposed publicly
metrics: 127.0.0.1:2000

# Automated maintenance & graceful drain on deployment rollover
no-autoupdate: false
grace-period: 30s

# Ingress Rules Matrix
ingress:
  # WhatsApp Webhook Ingress -> Routed directly to Fastify API Gateway
  - hostname: ${TUNNEL_HOSTNAME}
    path: ^/webhooks/whatsapp.*
    service: http://127.0.0.1:3000
    originRequest:
      connectTimeout: 5s
      tcpKeepAlive: 30s
      noTLSVerify: false
      disableChunkedEncoding: false

  # Application Liveness & Health Probe
  - hostname: ${TUNNEL_HOSTNAME}
    path: ^/health$
    service: http://127.0.0.1:3000
    originRequest:
      connectTimeout: 5s
      tcpKeepAlive: 30s
      noTLSVerify: false

  # Fallback Catch-All Rule: Rejects any unauthorized routes with HTTP 404
  # Guarantees internal endpoints (/metrics, /admin, local ports) are never leaked
  - service: http_status:404
