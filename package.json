{
  "name": "scheduler-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SchedulerBot Model C v4.4 HYBRID — WhatsApp Cloud API v22.0 & Omnichannel Message Scheduler Platform",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "adapters/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "vitest run && turbo run test",
    "test:unit": "vitest run",
    "typecheck": "turbo run typecheck",
    "lint:v12-guard": "node scripts/check-v12-guardrails.mjs",
    "create:adapter": "node tools/create-adapter/index.js",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
